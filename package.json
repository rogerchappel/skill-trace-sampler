{
  "name": "skill-trace-sampler",
  "version": "0.1.0",
  "description": "Sample agent run transcripts into safe skill fixture packs",
  "type": "module",
  "bin": {
    "skill-trace-sampler": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "docs",
    "examples",
    "scripts",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test dist/tests/*.test.js",
    "smoke": "npm run build && node dist/src/cli.js --help && node dist/src/cli.js examples/sample.txt --format markdown",
    "validate": "bash scripts/validate.sh",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs",
    "release:check": "npm run check && npm run build && npm test && npm run smoke && npm run validate && npm run package:smoke",
    "lint": "npm run check"
  },
  "keywords": [
    "agent-skill",
    "cli",
    "local-first",
    "fixtures"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/skill-trace-sampler.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/skill-trace-sampler/issues"
  },
  "homepage": "https://github.com/rogerchappel/skill-trace-sampler#readme"
}
